{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pano",
  "version": "0.1.0",
  "identifier": "dev.pano.panel",
  "build": {
    "frontendDist": "../pano-ui/web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir pano-ui/web dev",
    "beforeBuildCommand": "pnpm --dir pano-ui/web build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
